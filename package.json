{
  "name": "dime-web-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
"generate-env": "node src/tools/scripts/generate-env.js",
    "prestart": "npm run generate-env",
    "start": "ng serve",
    "prebuild": "npm run generate-env",
    "build": "ng build",
    "watch": "npm run generate-env && ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:DIME-WEB-APP": "node dist/DIME-WEB-APP/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/google-maps": "^20.2.4",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@azure/msal-angular": "^4.0.19",
    "@azure/msal-browser": "^4.23.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.2",
    "@angular/cli": "^20.3.2",
    "@angular/compiler-cli": "^20.3.0",
    "@ngx-env/builder": "^20.1.1",
    "@types/express": "^5.0.1",
    "@types/google.maps": "^3.58.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "dotenv": "^17.2.2",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}

