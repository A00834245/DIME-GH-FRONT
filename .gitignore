# Root-level gitignore

# Node / Angular common
node_modules/
dist/
out-tsc/
/tmp
/bazel-out

# VS Code
.vscode/
.history/*

# Logs
npm-debug.log
yarn-error.log
libpeerconnection.log
testem.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Environment and secrets
# Ignore env files at root and within the app subfolder
.env
DIME-WEB-APP/.env
.env.local
.env.development.local
.env.test.local
.env.production.local
/src/environment/environment.ts
/src/app/core/environments/environment.ts

# Angular cache / misc
.angular/
.angular/cache/
.sass-cache/
/connect.lock
/coverage
/typings

# System files
.DS_Store
Thumbs.db

# Warp workspace
warp/
WARP.md
warp.md

# editor config
.editorconfig
**/.editorconfig


