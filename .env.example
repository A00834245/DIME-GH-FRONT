# Google Maps API Configuration
# Copy this file to .env and replace with your actual values

# Google Maps API Key - Get from Google Cloud Console
NG_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Map ID - Custom map style identifier
NG_APP_GOOGLE_MAP_ID=your_map_id_here

# Google Dataset ID - For data visualization features
NG_APP_GOOGLE_DATASET_ID=your_dataset_id_here

# Google Style ID - Custom map styling
NG_APP_GOOGLE_STYLE_ID=your_style_id_here

# Google Project ID - Your Google Cloud project identifier
NG_APP_GOOGLE_PROJECT_ID=your_project_id_here
# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to git - it contains sensitive information

# Azure AD B2C Configuration
NG_APP_AZURE_CLIENT_ID=your-client-id-from-azure-portal
NG_APP_AZURE_AUTHORITY_DOMAIN=yourtenant.b2clogin.com
NG_APP_AZURE_TENANT_NAME=yourtenant.onmicrosoft.com
NG_APP_AZURE_LOGIN_USER_FLOW=B2C_1_signin
NG_APP_AZURE_REDIRECT_URI=http://localhost:4200/auth-callback

# How to get these values:
# 1. Client ID: Azure Portal → Azure AD B2C → App registrations → Your app → Overview → Application (client) ID
# 2. Authority Domain: Replace 'yourtenant' with your actual tenant name
# 3. Tenant Name: Replace 'yourtenant' with your actual tenant name  
# 4. User Flow: Azure Portal → Azure AD B2C → User flows → Your sign-in flow name
# 5. Redirect URI: Must be configured in Azure Portal → App registrations → Authentication
