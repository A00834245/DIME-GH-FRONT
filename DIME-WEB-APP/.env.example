# Google Maps API Configuration
# Copy this file to .env and replace with your actual values

# Google Maps API Key - Get from Google Cloud Console
NG_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Map ID - Custom map style identifier
NG_APP_GOOGLE_MAP_ID=your_map_id_here

# Google Dataset ID - For data visualization features
NG_APP_GOOGLE_DATASET_ID=your_dataset_id_here

# Google Style ID - Custom map styling
NG_APP_GOOGLE_STYLE_ID=your_style_id_here

# Google Project ID - Your Google Cloud project identifier
NG_APP_GOOGLE_PROJECT_ID=your_project_id_here